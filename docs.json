{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "SmartSend API",
  "colors": {
    "primary": "#14B8A6",
    "light": "#5EEAD4",
    "dark": "#0D9488"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navigation": {
    "languages": [
      {
        "language": "en",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "en/introduction",
              "en/authentication",
              "en/quickstart",
              "en/members-and-assignees"
            ]
          },
          {
            "group": "Make.com API reference",
            "openapi": "openapi-make.json"
          }
        ]
      },
      {
        "language": "he",
        "groups": [
          {
            "group": "התחלה",
            "pages": [
              "he/introduction",
              "he/authentication",
              "he/quickstart",
              "he/members-and-assignees"
            ]
          },
          {
            "group": "Make.com API",
            "openapi": "openapi-make.json"
          }
        ]
      }
    ]
  },
  "api": {
    "playground": {
      "display": "interactive"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "App",
        "href": "https://app.smartsend.co.il"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open SmartSend",
      "href": "https://app.smartsend.co.il"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude"
    ]
  },
  "footer": {
    "socials": {
